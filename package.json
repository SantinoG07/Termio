{
  "name": "termio-navathon-g6",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:ingest": "node scripts/smoke-ingest.mjs",
    "key:create": "node scripts/create-integration-key.mjs",
    "typecheck": "tsc -b",
    "collector": "node --experimental-strip-types --env-file=.env.collector scripts/poll-source.ts",
    "collector:once": "node --experimental-strip-types --env-file=.env.collector scripts/poll-source.ts --once",
    "local:server": "node --experimental-strip-types --env-file-if-exists=.env.backend backend/src/main.ts",
    "local:start": "npm run build && npm run local:server",
    "test:local": "node --experimental-strip-types scripts/verify-local.mjs",
    "supabase": "supabase"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "supabase": "^2.75.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^5.0.4"
  }
}
