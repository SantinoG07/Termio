# Opcional: copiar como .env.backend. Solo backend, nunca variables VITE_ para secretos.
LOCAL_API_PORT=3001
LOCAL_DB_PATH=data/termio.db
LOCAL_GROUPS_FILE=backend/config/groups.json

# Token de lectura de cada API fuente (vacío si el grupo acordó API sin autenticación).
GROUP_1_READ_TOKEN=
GROUP_2_READ_TOKEN=
GROUP_3_READ_TOKEN=
GROUP_4_READ_TOKEN=
GROUP_5_READ_TOKEN=

# Token para enviar eventos a Grupo 5; distinto del token de lectura si así se acuerda.
GROUP_5_EVENTS_TOKEN=

# Recepción POST opcional desde herramientas en esta PC; mínimo 24 caracteres.
# Vacío = recepción de ese productor deshabilitada. No se usan para los GET.
GROUP_1_INGEST_TOKEN=
GROUP_2_INGEST_TOKEN=
GROUP_3_INGEST_TOKEN=
GROUP_4_INGEST_TOKEN=
GROUP_5_INGEST_TOKEN=
