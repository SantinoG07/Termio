# Copiar a .env.collector. Ese archivo privado no va a Git.
# ACA VA LA URL PUBLICA. Luego reemplazar por http://IP_DEL_ESP32/api/status.
SOURCE_URL=https://tu-api.example.invalid/api/status
# Opcional: token propio del servidor fuente / ESP32. No es la credencial de Supabase.
SOURCE_TOKEN=
# false para fuente pública HTTPS; true solo para pruebas HTTP en la LAN de confianza.
ALLOW_SOURCE_HTTP=false

# Destino: API existente de Termio. NO CAMBIA cuando cambia el ESP32.
INGEST_URL=https://TU_PROJECT_REF.supabase.co/functions/v1/ingest-record
# Credencial privada del grupo generada con npm run key:create -- 6
INGEST_KEY=
EXPECTED_NODE_ID=monitoring_center
EXPECTED_GROUP=6
EXPECTED_ENVIRONMENT=test
POLL_INTERVAL_MS=10000
REQUEST_TIMEOUT_MS=5000
